# Copie para .env e preencha. Nunca commitar o .env.

ENVIRONMENT=production

# Chave mestra: criptografa api_keys no banco e assina a sessão do painel.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se trocar depois, as api_keys já salvas no banco deixam de ser legíveis.
SECRET_KEY=

# Token que vai na URL dos webhooks (ex.: /webhooks/evolution/<token>).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# URL pública da API (destino dos webhooks da Evolution/Apify), sem barra no fim.
PUBLIC_BASE_URL=https://

# Banco e fila. No docker-compose estes dois são sobrescritos pelos serviços internos.
DATABASE_URL=postgresql+psycopg://creapar:senha@localhost:5432/creapar
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=

TIMEZONE=America/Sao_Paulo

# Evolution API (servidor inicial; outros servidores são cadastrados pelo painel)
EVOLUTION_BASE_URL=https://clientes-apicreazap.ljdnkk.easypanel.host
EVOLUTION_API_KEY=

# Chatwoot
CHATWOOT_BASE_URL=https://clientes-chatwoot.ljdnkk.easypanel.host
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=

# Apify
APIFY_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Google Calendar (OAuth client "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
